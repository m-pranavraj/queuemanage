# ZP Sampark - Environment Configuration
# Copy this file to '.env' and fill in your details.

# Required: PostgreSQL connection string (Supabase, Neon, or local database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zp_sampark"

# Required: Port for the API server (defaults to 5000 if not set)
PORT=5000

# Required: JWT signing key for role-based authentication session security
JWT_SECRET="generate_a_secure_random_string_here_32_characters"
